# Ignore everything by default
*

# Root source and config files
!src/
!static/
!static/**
!Cargo.lock
!Cargo.toml
!application.yaml
!banner.txt
!rustfmt.toml
!rust-toolchain.toml
!.cargo
!docker/
!docker/**

# Documentation shipped into the image and served at runtime
!README.md
!docs/
!docs/**

# Crates directory (all subdirectories and Cargo.toml files needed for Docker build)
!crates/
!crates/**
