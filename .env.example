# Copy to `.env` and adjust before running `docker compose up -d`.

# Host port the cosmox web server is published on.
COSMX_HTTP_PORT=8080

# Log verbosity of the container (`error|warn|info|debug|trace`).
COSMX_RUST_LOG=info

# Tag of the locally built image. Leave empty to use `cosmox:local`.
# To run a published image instead, remove the `build:` block in
# docker-compose.yml and set e.g. `ghcr.io/<owner>/<repo>:<tag>` here.
COSMX_IMAGE=

# Database credentials shared by the `cosmox` service and the `mariadb` service.
COSMX_DATABASE_USER=cosmox
COSMX_DATABASE_PASSWORD=cosmox
COSMX_DATABASE_NAME=cosmox
COSMX_MARIADB_ROOT_PASSWORD=cosmox-root
COSMX_MARIADB_IMAGE=mariadb:12.3.2
